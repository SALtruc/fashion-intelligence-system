# Raw course data is intentionally absent from this checkout. Keep it out of Git if restored locally.
datasets/**/*.csv
datasets/**/*.jpg

# preprocessed_datasets is tracked on purpose. The manifests define the splits every
# notebook reads, so a fresh checkout has to land on the same rows without re-running
# the EDA notebook first. 16 MB of text, and no images are written here.

# Generated run evidence stays local; keep lightweight placeholders and READMEs tracked.
artifacts/**
!artifacts/**/
!artifacts/**/.gitkeep
!artifacts/**/README.md

# Local environments, caches and generated bundles.
__MACOSX/
.DS_Store
Thumbs.db
.ipynb_checkpoints/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Local scratch space: drafts, downloaded documents, throwaway renders. Nothing here
# is part of the submission, so it never belongs in the repository.
/tmp/

# Internal working checklist. Kept on the author's machine, not shared in the repo.
/SUBMISSION.md
.venv/
venv/
datasets.zip
task1_kaggle_bundle.zip
*.zip
*.sha256.txt
/kaggle/
.mypy_cache/

# Generated model binaries and archives stay local. Task 1's run tree joined the other
# tasks' under artifacts/, which the block above already keeps out of git.
/outputs/**/*.joblib
/outputs/**/*.npy
/outputs/**/*.npz
/outputs/**/*.pt
/outputs/**/*.zip

preprocessed_datasets/**/*.csv
preprocessed_datasets/**/*.jpg

# Externally collected data - share via Drive, never git.
# The provided dataset is licensed for this assignment only ("Any use beyond this
# scope is not permitted"), and the collected sets are large. Both are distributed
# through the team Drive folder A2_ExternalData; only the code lives here.
# Provenance for every set is in docs/EXTERNAL_DATA.md.
Dataset/
external_datasets/
_UPLOAD_*/

# Task 2 local datasets and generated NumPy caches - share via Drive, never Git.
/ExtraSeasonData/
/notebooks/task2/dataset1/
/notebooks/task2/dataset2/
/notebooks/task2/dataset3/
/notebooks/task2/ExtraSeasonData/
/preprocessed_datasets/task2/*.npy
